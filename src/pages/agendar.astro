---
import Base from '../layouts/Base.astro';
import FundoLogo from '../components/FundoLogo.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const cal = site.calLink?.trim();
const tipos = ['Gravação de louvor ao vivo', 'Session acústica', 'Produção musical (áudio)', 'Videoclipe', 'Entrevista ou podcast', 'Cobertura de evento', 'Conteúdo para redes'];
---
<Base titulo="Agendar" descricao="Agende uma gravação, session ou produção musical com a Haja Produções." navClara>
  <section class="pagina-clara agendar" data-faixa-clara>
    <FundoLogo />
    <div class="wrap">
      <header class="cab-pagina">
        <p class="eyebrow">Agendar</p>
        <h1>Vamos marcar a sua gravação.</h1>
        <p class="lead">{cal ? 'Escolha o melhor horário na agenda abaixo.' : 'Conte o que você quer produzir. A mensagem já vai pronta para o nosso WhatsApp.'}</p>
      </header>

      {cal ? (
        <div class="cal" id="cal" data-cal={cal}></div>
      ) : (
        <form class="pedido" id="pedido" data-whats={site.whatsapp}>
          <fieldset>
            <legend>O que você quer produzir?</legend>
            <div class="opcoes">
              {tipos.map((t, i) => (
                <label class="opcao"><input type="checkbox" name="tipo" value={t} id={`tipo-${i}`} /><span>{t}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="campos">
            <label for="nome">Seu nome<input id="nome" name="nome" type="text" autocomplete="name" required /></label>
            <label for="projeto">Artista, ministério ou igreja<input id="projeto" name="projeto" type="text" /></label>
            <label for="quando">Data que você prefere<input id="quando" name="quando" type="date" /></label>
            <label for="detalhes" class="largo">Detalhes<textarea id="detalhes" name="detalhes" rows="4" placeholder="Quantas músicas, banda completa ou voz e violão, onde vai ser..."></textarea></label>
          </div>
          <p class="erro" id="erro" hidden>Escolha pelo menos um tipo de produção e escreva seu nome.</p>
          <button class="btn btn-laranja" type="submit">Enviar pelo WhatsApp</button>
          <p class="nota">Abre o WhatsApp com a mensagem pronta para o número {site.whatsappExibicao}. Nada é enviado sem você confirmar lá.</p>
        </form>
      )}
    </div>
  </section>
</Base>

<script>
  // Cal.com, quando houver um link configurado no painel
  const cal = document.getElementById('cal');
  if (cal) {
    const link = cal.dataset.cal!;
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => a.q.push(ar);
      const d = C.document;
      C.Cal = C.Cal || function (...args: any[]) {
        const cal = C.Cal;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (args[0] === L) {
          const api: any = function (...a: any[]) { p(api, a); };
          const ns = args[1];
          api.q = api.q || [];
          if (typeof ns === 'string') { cal.ns[ns] = cal.ns[ns] || api; p(cal.ns[ns], args); p(cal, ['initNamespace', ns]); }
          else p(cal, args);
          return;
        }
        p(cal, args);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');
    const Cal = (window as any).Cal;
    Cal('init', 'haja', { origin: 'https://cal.com' });
    Cal.ns.haja('inline', { elementOrSelector: '#cal', calLink: link, layout: 'month_view' });
    Cal.ns.haja('ui', { theme: 'light', cssVarsPerTheme: { light: { 'cal-brand': '#FF5A1F' } }, hideEventTypeDetails: false });
  }

  // Pedido pelo WhatsApp, quando não houver Cal.com
  const form = document.getElementById('pedido') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const dados = new FormData(form);
    const tipos = dados.getAll('tipo') as string[];
    const nome = String(dados.get('nome') || '').trim();
    const erro = document.getElementById('erro')!;
    if (!tipos.length || !nome) {
      erro.hidden = false;
      return;
    }
    erro.hidden = true;
    const quando = String(dados.get('quando') || '');
    const linhas = [
      `Olá, Haja! Sou ${nome}${dados.get('projeto') ? ` (${dados.get('projeto')})` : ''}.`,
      `Quero agendar: ${tipos.join(', ')}.`,
      quando ? `Data que prefiro: ${quando.split('-').reverse().join('/')}.` : '',
      String(dados.get('detalhes') || '').trim(),
    ].filter(Boolean);
    const url = `https://wa.me/${form.dataset.whats}?text=${encodeURIComponent(linhas.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
