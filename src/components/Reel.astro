---
import { Image } from 'astro:assets';
import type { Reel } from '../lib/site';
import { url } from '../lib/site';

interface Props {
  reel: Reel;
  class?: string;
  eager?: boolean;
  sizes?: string;
  instagram: string;
}
const { reel, class: classe = '', eager = false, sizes = '(max-width: 560px) 60vw, 300px', instagram } = Astro.props;
const { titulo, artista, legenda, capa, instagram: codigo } = reel.data;
const nome = artista ? `${titulo} · ${artista}` : titulo;
---
<a
  class={`reel ${classe}`}
  href={`https://www.instagram.com/${instagram}/reel/${codigo}/`}
  target="_blank"
  rel="noopener"
  aria-label={`Assistir no Instagram: ${nome}`}
  data-categoria={reel.data.categoria}
>
  <Image
    src={capa}
    alt=""
    widths={[240, 360, 540, 720]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="reel-capa"
  />
  <span class="reel-topo"><span>Reels</span><svg><use href="#i-reels" /></svg></span>
  <span class="reel-play"><svg viewBox="0 0 24 24"><use href="#i-play" /></svg></span>
  <span class="reel-acoes"><svg><use href="#i-coracao" /></svg><svg><use href="#i-coment" /></svg><svg><use href="#i-envia" /></svg></span>
  <span class="reel-base">
    <span class="reel-perfil"><img src={url('img/perfil.jpg')} alt="" width="26" height="26" loading="lazy" /><span>{instagram}</span></span>
    <span class="reel-legenda">{artista ? <><b>{titulo}</b> · {artista}</> : legenda || titulo}</span>
  </span>
</a>
